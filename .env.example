GEMINI_API_KEY=your_gemini_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Set USE_MOCK=0 or run `make film` for the real pipeline.
USE_MOCK=1
KEYFRAMES_PROVIDER=mock
NARRATION_PROVIDER=mock
GEMINI_TTS_VOICE=Kore
MUSIC_FILE=/absolute/path/to/your/licensed-track.wav
MUSIC_LICENSE=describe-the-license-or-permission
# Optional attribution to include in run/edit records:
# MUSIC_ATTRIBUTION=Composer Name — Track Title
# Optional Gemini TTS delivery direction:
# GEMINI_TTS_STYLE=Warm, conversational Amharic narration with natural storytelling cadence.